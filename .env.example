# Supabase — Project Settings › API Keys
SUPABASE_URL=
# The publishable key is safe here: row-level security only allows inserting new bookings.
SUPABASE_PUBLISHABLE_KEY=

# Email notifications for new bookings (resend.com) — optional
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Midad Institute <bookings@your-domain.com>
ADMIN_NOTIFY_EMAIL=

# Public contact details shown on the site
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
