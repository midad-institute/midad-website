# Supabase — Project Settings › API Keys
SUPABASE_URL=
# The publishable key is safe here: row-level security only allows inserting new bookings.
SUPABASE_PUBLISHABLE_KEY=

# Same two values, exposed to the browser for the admin dashboard (/ar/admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email notifications for new bookings (resend.com) — optional
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Midad Institute <bookings@your-domain.com>
ADMIN_NOTIFY_EMAIL=

# Public contact details shown on the site
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp alert to the admin phone via CallMeBot (free, personal use).
# Get the key: save +34 644 52 74 88 (check callmebot.com for the current number), send "I allow callmebot to send me messages".
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
